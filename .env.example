# ---------------------------------------------------------------------------
# HoursMedia — environment template
# Copy to `.env.local` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site origin, no trailing slash. Used for canonicals, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# GoHighLevel (HighLevel) integration — optional.
# The site works without these; leads are still stored to `.data/submissions.jsonl`.
# Leave blank until the client's account and credentials are available.
# ---------------------------------------------------------------------------
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Optional: open an opportunity on each new lead.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Override only if HighLevel changes endpoints.
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# ---------------------------------------------------------------------------
# Durable lead delivery — optional but strongly recommended in production.
# When set, every accepted submission is POSTed as JSON to this URL (in addition
# to the local `.data` store). Point it at a durable sink: Zapier / Make /
# Google Sheets / Slack / an email service.
# If no durable sink is configured (neither this nor the GHL_* variables), a
# failed local write makes the API return 502 instead of silently dropping the
# lead, so nothing is lost without anyone noticing.
# ---------------------------------------------------------------------------
LEADS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Analytics — optional and consent-gated.
# Nothing loads until a visitor allows analytics AND a domain is set here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
